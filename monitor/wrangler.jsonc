/*
 * Мониторинг serafim6s.ru: раз в 5 минут проверяет /api/health (снаружи, из сети Cloudflare) и пишет в Telegram,
 * когда сайт перестал отвечать и когда снова заработал. Выкладка: npx wrangler deploy -c monitor/wrangler.jsonc
 * Секрет: TELEGRAM_BOT_TOKEN (бот заказов). Кому писать — ALERT_CHAT_IDS.
 */
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "serafim-monitor",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "STATE", "id": "29da363b6e084e24b3d709c20832f2ca" }],
  "vars": {
    "CHECK_URL": "https://serafim6s.ru/api/health",
    "ALERT_CHAT_IDS": "6740047378"
  },
  "observability": { "enabled": true }
}
