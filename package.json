{
  "name": "serafim-store",
  "version": "1.0.0",
  "private": true,
  "description": "SERAFIM — интернет-магазин: каталог, корзина, оформление заказа, оплата и админка",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o public/css/styles.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o public/css/styles.css --watch",
    "build": "npm run build:css",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^4.22.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
