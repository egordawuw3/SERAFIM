/*
 * Cloudflare Workers: сайт + API + база заявок D1. Выкладка — Workers Builds из GitHub
 * (команды сборки и выкладки — в DEPLOY.md) или вручную: npm run cf:deploy.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serafim",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  // Сайт живёт на serafim6s.ru; временный адрес *.workers.dev выключен, чтобы не было дубля сайта.
  "workers_dev": false,
  // Свои домены: DNS-записи и сертификат HTTPS Cloudflare создаёт сам. www перенаправляется на основной адрес правилом в панели.
  "routes": [
    { "pattern": "serafim6s.ru", "custom_domain": true },
    { "pattern": "www.serafim6s.ru", "custom_domain": true }
  ],
  // Без отдельных публичных адресов у каждой версии: сайт доступен только там, где мы его опубликовали.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Неизвестный адрес → dist/404.html с кодом 404; /about → /about/index.html без редиректа на /about/ (canonical — без слэша).
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // Код запускается только для API и редиректов (каталог, короткие ссылки) — остальное Cloudflare отдаёт сам.
    "run_worker_first": ["/api/*", "/catalog", "/p/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serafim",
      "database_id": "6ed9f7db-0e7d-4426-af4e-d6aae8863d45",
      "migrations_dir": "migrations"
    }
  ],
  // Чистка устаревших заявок раз в сутки (03:00 UTC).
  "triggers": { "crons": ["0 3 * * *"] },
  // Логи Worker в панели Cloudflare (ошибки отправки в Telegram и т.п.).
  "observability": { "enabled": true },
  "vars": {
    // Запросы к API с других адресов (Origin) отклоняются.
    "SITE_ORIGIN": "https://serafim6s.ru",
    // Боевой СДЭК: заказы создаются в личном кабинете продавца (ключи — секреты CDEK_CLIENT_ID / CDEK_CLIENT_SECRET).
    "CDEK_ENV": "prod"
  },
  /*
   * Превью для проверки нового: отдельный Worker serafim-preview на *.workers.dev — без домена, со своей
   * тестовой базой и учебной средой СДЭК (заказы не настоящие). Собирать с PREVIEW=1 (закрыто от поисковиков):
   *   PREVIEW=1 npm run build && npx wrangler d1 migrations apply serafim-preview --remote --env preview && npx wrangler deploy --env preview
   */
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "serafim-preview",
          "database_id": "ab8cbbce-f963-4869-b768-7581afd51b33",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "SITE_ORIGIN": "",
        "CDEK_ENV": "test"
      }
    }
  }
}
