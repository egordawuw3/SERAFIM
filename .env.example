# Порт сервера
PORT=3000

# Telegram-бот для заявок.
# 1) Создайте бота у @BotFather и скопируйте токен.
# 2) Добавьте бота в чат/группу, куда должны приходить заявки, и напишите туда любое сообщение.
# 3) Откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите chat.id (у групп он отрицательный).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сколько обратных прокси стоит перед сервером (nginx, Yandex Cloud, Render): обычно 1. 0 — заголовку X-Forwarded-For не доверяем.
# ВАЖНО: за прокси с TRUST_PROXY=0 все покупатели делят один IP и один лимит заявок (5 за 10 минут на всех),
# а TRUST_PROXY=1 без прокси позволяет подделать IP. Сервер предупредит в логе, если видит прокси при 0.
TRUST_PROXY=0

# Адрес сайта без слэша в конце, например https://serafim.ru. Если задан — заявки с другим Origin отклоняются.
SITE_ORIGIN=

# Сколько дней хранить заявки в data/orders.jsonl (в политике конфиденциальности — не дольше 3 лет).
ORDERS_RETENTION_DAYS=1095

# Адрес сайта для сборки (npm run build): canonical, Open Graph, Schema.org, sitemap.xml в готовом HTML.
# Без него сайт работает, но поисковикам и мессенджерам уходят неполные метаданные.
VITE_SITE_URL=
