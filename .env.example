# Порт сервера
PORT=3000

# Telegram-бот для заявок.
# 1) Создайте бота у @BotFather и скопируйте токен.
# 2) Добавьте бота в чат/группу, куда должны приходить заявки, и напишите туда любое сообщение.
# 3) Откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите chat.id (у групп он отрицательный).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 — если сервер стоит за обратным прокси (nginx, Render, Railway), чтобы лимит заявок считался по реальному IP
TRUST_PROXY=0
