# Порт и публичный адрес сайта (нужен для ссылок возврата из оплаты)
PORT=3000
BASE_URL=http://localhost:3000

# Пароль входа в админку /admin  (ОБЯЗАТЕЛЬНО поменять)
ADMIN_PASSWORD=change-me
# Секрет для подписи cookie админки — любая длинная случайная строка
SESSION_SECRET=replace-with-long-random-string

# Уведомления о заказах в Telegram (необязательно)
# Создать бота: @BotFather, chat id узнать через @userinfobot (или id группы)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Онлайн-оплата ЮKassa (необязательно). Без этих ключей заказ
# оформляется с оплатой после подтверждения менеджером.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — передавать чек по 54-ФЗ (нужно, если подключены онлайн-чеки ЮKassa)
YOOKASSA_SEND_RECEIPT=0
# Код ставки НДС для чека: 1 — без НДС (подходит для УСН)
YOOKASSA_VAT_CODE=1
